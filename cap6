<!DOCTYPE html>
<html>
  <head>
    <script src="https://unpkg.com/react@18/umd/react.development.js"></script>
    <script src="https://unpkg.com/react-dom@18/umd/react-dom.development.js"></script>
    <script src="https://unpkg.com/@babel/standalone/babel.min.js"></script>
  </head>
  <body>
    <div id="app"></div>

    <script type="text/babel">
      const app = document.getElementById('app');

      // Componente filho que recebe props com desestruturação e operador ternário
      function Header({ title }) {
        return <h1>{title ? title : 'Default title'}</h1>;
      }

      // Componente pai
      function HomePage() {
        const names = ['Ada Lovelace', 'Grace Hopper', 'Margaret Hamilton'];

        return (
          <div>
            {/* Passando props personalizadas para o componente Header */}
            <Header title="Develop. Preview. Ship." />
            <Header title="React Foundations" />

            {/* Iterando pela lista usando .map() e definindo a chave única (key) */}
            <ul>
              {names.map((name) => (
                <li key={name}>{name}</li>
              ))}
            </ul>
          </div>
        );
      }

      const root = ReactDOM.createRoot(app);
      root.render(<HomePage />);
    </script>
  </body>
</html>
